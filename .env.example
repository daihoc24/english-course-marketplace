# Copy this file to .env for Docker Compose or export these variables in your deploy platform.
# Never commit real credentials.
MYSQL_DATABASE=course_marketplace
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

DB_URL=jdbc:mysql://db:3306/course_marketplace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=app_user
DB_PASSWORD=replace-with-a-long-random-password

# Only Flyway should change the database schema in deploy environments.
JPA_DDL_AUTO=validate
MAX_UPLOAD_FILE_SIZE=100MB
MAX_UPLOAD_REQUEST_SIZE=105MB
MAX_VIDEO_UPLOAD_BYTES=104857600
JWT_SIGNER_KEY=replace-with-a-64-character-or-longer-random-secret

# Docker Compose is intended for portfolio/demo runs, so demo accounts can be enabled.
SPRING_PROFILES_ACTIVE=demo
DEMO_LEARNER_PASSWORD=replace-with-demo-learner-password
DEMO_SELLER_PASSWORD=replace-with-demo-seller-password
DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password

MAIL_USERNAME=replace-with-mail-account
MAIL_PASSWORD=replace-with-mail-app-password
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google
VNPAY_RETURN_URL=http://localhost:5173/payment-result
VNPAY_TMN_CODE=replace-with-sandbox-code
VNPAY_HASH_SECRET=replace-with-sandbox-secret
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_RETURN_URL=http://localhost:5173/payment-result
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8080/api

VITE_API_BASE_URL=http://localhost:8080/api
